<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="action_hostel_room" model="ir.actions.act_window">
                <field name="name">Room</field>
                <field name="type">ir.actions.act_window</field>
                <field name="res_model">hostel.room</field>
                <field name="view_mode">tree,form</field>
                <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create a new Hostel Room.</p>
                </field>
        </record>

        <menuitem id="menu_custom_hostel_room" name="Hostel Room" web_icon="my_hostel,static/description/icon.png"/>
        <menuitem id="menu_all_hostel_room" parent="menu_custom_hostel_room" action="action_hostel_room" sequence="10" groups=""/>
        <menuitem id="hostel_rooms_menu" name="Hostel Rooms" parent="hostel_main_menu" action="action_hostel_room" sequence="2"/>
        <menuitem id="hostel_type_menu" name="Hostel" parent="hostel_main_menu" action="my_hostel.action_hostel" groups="my_hostel.group_hostel_manager" sequence="1"/>

        <record id="view_hostel_room_form_view" model="ir.ui.view">
                <field name="name">hostel.room.form</field>
                <field name="model">hostel.room</field>
                <field name="arch" type="html">
                <form>
                        <sheet>
                                <group>
                                        <field name="name" type="String" placeholder="Prime"/>
                                </group>
                                <group>
                                        <field name="room_no" type="Integer" placeholder="201"/>
                                </group>
                                <group>
                                        <field name="floor_no" type="Integer"/>
                                </group>
                                <group>
                                        <field name="rent_amount" widget="Monetary"/>
                                </group>
                                <group>
                                        <field name="currency_id" type="String" placeholder="USD"/>
                                        <field name="remarks"/>
                                        <field name="previous_room_id"/>
                                </group>
                                <group>
                                        <button name="log_all_room_members" string="Log Members" type="object"/>
                                        <button name="update_room_no" string = "Update Room No" type="object"/>
                                        <button name="action_remove_room_members"
                                                        string="Remove Room Members"
                                                        type="object"
                                                        class="btn-primary"
                                                />
                                        <button name="action_category_with_amount"
                                                        string="Log Category With Amount"
                                                        type="object"
                                                        class="btn-primary"/>
                                </group>
                        </sheet>
                </form>
                </field>
        </record>
</odoo>
